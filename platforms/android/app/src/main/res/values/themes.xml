<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark window background avoids a white flash before Compose draws the editor. -->
    <style name="Theme.IdeLevity" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/editor_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <color name="editor_background">#FF0D1117</color>
    <color name="launcher_background">#FF0D1117</color>
</resources>
